DATABASE_URL=postgresql://localhost:5432/livechess
REDIS_URL=redis://localhost:6379
PUBLISHER_INTERVAL_MS=500
INGEST_INTERVAL_MS=3000
# Local integration tests only (roundtrip.test.ts skips when unset).
# TEST_DATABASE_URL=postgresql://abhishekan@localhost:5433/livechess_test
# Redis database 1, so tests never write to the dev stream in database 0.
# TEST_REDIS_URL=redis://localhost:6379/1

# Optional Lichess API token (no scopes needed): raises the broadcast
# stream limit from 2 per IP to 8 per user.
# LICHESS_TOKEN=

# Supervisor (bun run supervisor, started by `bun run dev`).
# SUPERVISOR_MAX_ROUNDS=8
# SUPERVISOR_STREAM_SLOTS=2        # defaults to 8 when LICHESS_TOKEN is set
# SUPERVISOR_DISCOVER_MS=300000
